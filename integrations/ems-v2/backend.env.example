# CRM backend only. Do not use NEXT_PUBLIC_ for these settings.
# Public hosts documented by ems-v2/deploy/README.md; verify the target deployment.
EMS_V2_API_URL=https://api.ems.kimcommunication.com
EMS_V2_IAM_URL=https://iam.ems.kimcommunication.com

# Prefer an EMS integration account for automatic IAM login and token renewal.
EMS_V2_ADMIN_EMAIL=
EMS_V2_ADMIN_PASSWORD=

# Alternatively, a current EMS-v2 access token can be used for a short read test.
# A configured token takes priority over email/password; clear it to enable IAM login.
EMS_V2_ACCESS_TOKEN=
